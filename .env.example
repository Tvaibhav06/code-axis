# Copy to .env.local. Never commit secrets.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# A dedicated fictional test user created in your own Supabase project.
# No administrator/service-role key is needed for these smoke checks.
SUPABASE_SMOKE_EMAIL=
SUPABASE_SMOKE_PASSWORD=

# Free tier: fictional SampleCo data only. Google may use free-tier inputs and
# responses to improve its products. This setting does not change account billing.
GEMINI_API_KEY=
# Both slots currently use the one candidate that passed the live fixture.
# This does not provide independent model redundancy.
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODEL=gemini-3.6-flash
GEMINI_BILLING_TIER=free
AI_CHECKS_ENABLED=true
# Only required if you later choose a paid project. Configure billing yourself.
GEMINI_PAID_PROJECT_CONFIRMED=false
GEMINI_MONTHLY_SPEND_CAP_USD=

# Generate a random 32-byte secret. Required to call the deployed setup check.
# Leave the endpoint disabled by omitting this value when setup is finished.
PHASE0_SMOKE_TOKEN=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# The check route reserves these limits in the database before any provider call.
DEMO_AI_ATTEMPT_LIMIT=5
GLOBAL_AI_ATTEMPT_LIMIT=0

# Phase 1: server-only allocation. Never prefix these secrets with NEXT_PUBLIC_.
# Apply migrations 001–007, then seed:demo and seed:content before enabling access.
SUPABASE_SERVICE_ROLE_KEY=
DEMO_ACCESS_ENABLED=false
DEMO_POOL_SIZE=24
# Generated by seed:demo in .env.local. Copy privately to Vercel after setup.
# Includes the 24 demo slots and 2 dedicated permission-test workspaces.
DEMO_POOL_ACCOUNTS_JSON=
